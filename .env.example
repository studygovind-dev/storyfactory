# Copy this file to .env and fill in your keys. Never share .env with anyone.
GEMINI_API_KEY=            # aistudio.google.com -> Get API key (free tier available)
KLING_ACCESS_KEY=          # klingai.com developer/API page (paid credits)
KLING_SECRET_KEY=
ELEVEN_API_KEY=            # elevenlabs.io -> Profile -> API key
# Pick 5 voices in ElevenLabs (Voice Library) and paste each voice ID:
VOICE_NARRATOR_MALE=
VOICE_NARRATOR_FEMALE=
VOICE_MALE_DEEP=
VOICE_MALE_GRUFF=
VOICE_MALE_SMOOTH=
VOICE_FEMALE_WARM=
VOICE_FEMALE_SOFT=
VOICE_CHILD_GIRL=
VOICE_CHILD_BOY=
# Telegram: message @BotFather -> /newbot -> token. Chat ID: message @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
